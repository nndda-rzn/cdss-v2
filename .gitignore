# ===== Secrets & PHI (NEVER COMMIT) =====
secrets/*
!secrets/.gitkeep
*.key
*.pem
.env
.env.*
!.env.example

# ===== Database (PHI) =====
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ===== Runtime Storage (PHI: EKG images, heatmaps, reports) =====
storage/
uploads/
heatmaps/
reports/
processed/

# ===== Model Artifacts (large, external from Kaggle) =====
models/**/*.pt
models/**/*.onnx
models/**/*.pth
models/**/*.weights
!models/**/metadata.json
!models/**/README.md
!models/README.md

# ===== Litestream =====
litestream-data/
*.litestream

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# The broad Python "lib/" rule above must not ignore frontend source.
!frontend/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ===== Node / Frontend =====
node_modules/
dist/
dist-ssr/
.vite/
*.local
.eslintcache
coverage/
.turbo/

# ===== Build output (frontend -> backend static) =====
backend/app/static/assets/
backend/app/static/index.html

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

